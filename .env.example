# TradeZero API credentials — NEVER commit real values.
# Get keys: TradeZero Portal -> Enable API Trading -> API Key Management.
# Start with PAPER account keys. The secret is shown exactly once.
#
# Load with:  export $(grep -v '^#' .env | xargs)   (after copying to .env)
TZ_API_KEY_ID=your-public-key-here
TZ_API_SECRET_KEY=your-secret-key-here
